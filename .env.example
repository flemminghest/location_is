# Copy to .env for local development. Never commit your real .env file.
# Datafordeleren credentials are required for BBR/MAT GraphQL queries.
DATAFORDELER_API_KEY=put-your-Datafordeler-API-key-here
# Optional override; current flexible GraphQL endpoint:
DATAFORDELER_GRAPHQL_URL=https://graphql.datafordeler.dk/flexible/v3
# Optional port:
PORT=3000
